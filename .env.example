# Copy file ini jadi .env lalu isi nilainya.
# JANGAN commit file .env — sudah masuk .gitignore.

# --- akun Zoi ---
ZOI_EMAIL=your-email@gmail.com
ZOI_PASSWORD=your-zoi-password

# ID device yang dipakai saat sign-in. Bikin sendiri, 16 karakter hex:
#   openssl rand -hex 8
ZOI_DEVICE_ID=0123456789abcdef

# --- akses email buat baca kode OTP ---
# Gmail butuh App Password, bukan password akun biasa.
# Bikin di: https://myaccount.google.com/apppasswords
ZOI_IMAP_HOST=imap.gmail.com
ZOI_IMAP_USER=your-email@gmail.com
ZOI_IMAP_PASS=your-16-char-app-password

# --- opsional ---
# ZOI_API_BASE=https://api.zoi.network/v1
# ZOI_STATE_DIR=~/.zoi-auto-sync
# ZOI_LOG_FILE=~/.zoi-auto-sync/zoi_bot.log
